<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.palette.product.domain.category.mapper.CategoryMapper">

    <!-- 활성화된 카테고리 전체 조회 -->
    <select id="findAllActive" resultType="CategoryResponse">
        SELECT id,
               name,
               sort_order,
               is_active
        FROM categories
        WHERE is_active = 1
        ORDER BY sort_order ASC
    </select>

    <!-- 카테고리 단건 조회 -->
    <select id="findById" resultType="CategoryResponse">
        SELECT id,
               name,
               sort_order,
               is_active
        FROM categories
        WHERE id = #{id}
    </select>

    <!-- 특정 카테고리의 서브카테고리 목록 조회 -->
    <select id="findSubCategoriesByCategoryId" resultType="SubCategoryResponse">
        SELECT id,
               category_id,
               name,
               sort_order,
               is_active
        FROM sub_categories
        WHERE category_id = #{categoryId}
          AND is_active = 1
        ORDER BY sort_order ASC
    </select>

</mapper>
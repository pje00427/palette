<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.palette.product.domain.product.mapper.ProductOptionMapper">

    <!-- 상품 옵션 단건 조회 -->
    <select id="findById" resultType="ProductOptionResponse">
        SELECT id,
               product_id,
               name,
               price,
               is_active
        FROM product_options
        WHERE id = #{id}
          AND is_active = 1
    </select>

</mapper>